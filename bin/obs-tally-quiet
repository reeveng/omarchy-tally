#!/bin/bash

# Hold the desk still for the length of a stream, and put it back afterwards.
#
# While a stream is live, notifications stay off the screen and the idle lock
# leaves it alone. Both are Omarchy's own switches, thrown the way a person
# throws them, so the indicators in the bar say what is going on.
#
# Only what this turned on is turned off again. Somebody who had do not disturb
# on before the stream started still has it on after, which is the whole reason
# there is a file here rather than a pair of assumptions.
#
#   obs-tally-quiet hold [--no-dnd] [--no-awake]
#   obs-tally-quiet release
#   obs-tally-quiet status
#
# A second hold while one is running does nothing, so a shell that restarts
# mid-stream does not lose what it is holding.

set -uo pipefail

STATE="${XDG_RUNTIME_DIR:-/tmp}/obs-tally-hold"

# The read is not quiet: -q suppresses the answer as well as the error, which
# is a reading of "off" for a desk that is already silent.
dnd_is_on() {
  [[ $(omarchy-shell notifications isDnd 2>/dev/null) == "on" ]]
}

stay_awake_is_on() {
  omarchy-toggle-idle status 2>/dev/null | grep -q '"enabled":true'
}

hold() {
  local want_dnd=1 want_awake=1 changed=""

  while (($#)); do
    case "$1" in
    --no-dnd) want_dnd=0 ;;
    --no-awake) want_awake=0 ;;
    *)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    esac
    shift
  done

  [[ -f $STATE ]] && exit 0

  if ((want_dnd)) && ! dnd_is_on; then
    omarchy-shell -q notifications setDnd true >/dev/null 2>&1 && changed+="dnd "
  fi

  if ((want_awake)) && ! stay_awake_is_on; then
    omarchy-toggle-idle stay-awake >/dev/null 2>&1 && changed+="awake "
  fi

  printf '%s\n' "$changed" >"$STATE"
  echo "holding: ${changed:-nothing}"
}

release() {
  [[ -f $STATE ]] || {
    echo "holding: nothing"
    exit 0
  }

  read -r changed <"$STATE"
  rm -f "$STATE"

  [[ $changed == *dnd* ]] && omarchy-shell -q notifications setDnd false >/dev/null 2>&1
  [[ $changed == *awake* ]] && omarchy-toggle-idle allow-idle >/dev/null 2>&1

  echo "released: ${changed:-nothing}"
}

case "${1:-status}" in
hold)
  shift
  hold "$@"
  ;;
release)
  release
  ;;
status)
  if [[ -f $STATE ]]; then
    read -r changed <"$STATE"
    echo "holding: ${changed:-nothing}"
  else
    echo "holding: nothing"
  fi
  ;;
*)
  echo "usage: ${0##*/} [hold [--no-dnd] [--no-awake]|release|status]" >&2
  exit 1
  ;;
esac
