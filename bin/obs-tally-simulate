#!/bin/bash

# Tell the tally light that OBS is doing something, without OBS doing it.
#
# The light is three states and two of them are hard to arrange on purpose: a
# stream has to be running, and a real stream needs somewhere to send it. This
# writes the word the state script reads first, so the dot can be looked at,
# screenshotted and worked on from a desk with OBS closed.
#
#   obs-tally-simulate live      the dot lights, the stream is announced,
#                                notifications go quiet, the screen stays awake
#   obs-tally-simulate idle      OBS is open and doing nothing
#   obs-tally-simulate closed    OBS is not there
#   obs-tally-simulate off       stop pretending; OBS answers for itself again
#   obs-tally-simulate           print what is being pretended, if anything

set -euo pipefail

# The same rule obs-tally-hold keeps: a name anybody could guess is written in
# this user's own runtime directory and nowhere shared, and never through a
# symlink somebody left at it.
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
if [[ ! -d $RUN_DIR || -L $RUN_DIR || ! -O $RUN_DIR ]]; then
  echo "no runtime directory of your own at $RUN_DIR, so there is nowhere private to keep this" >&2
  exit 1
fi

FILE="$RUN_DIR/obs-tally-state"

case "${1:-status}" in
live | idle | closed)
  # Unlinked rather than followed, then written with noclobber, so the open is
  # O_CREAT|O_EXCL and refuses anything that appeared at the name in between.
  rm -f -- "$FILE" 2>/dev/null
  if ! (
    set -C
    echo "$1" >"$FILE"
  ); then
    echo "could not write $FILE without following what is at it" >&2
    exit 1
  fi
  echo "pretending OBS is $1"
  ;;
off | none | clear)
  rm -f "$FILE"
  echo "pretending nothing; OBS answers for itself"
  ;;
status)
  if [[ -f $FILE && ! -L $FILE ]]; then
    echo "pretending OBS is $(cat "$FILE")"
  else
    echo "pretending nothing"
  fi
  ;;
*)
  echo "usage: ${0##*/} [live|idle|closed|off|status]" >&2
  exit 1
  ;;
esac
