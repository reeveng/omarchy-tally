#!/bin/bash

# One word for what OBS is doing: live, idle, or closed.
#
# OBS writes "==== Streaming Start ====" and "==== Streaming Stop ====" banners
# into the log of the session it is running, so whichever came last is the
# answer. Nothing here talks to the websocket, which means no plugin to install
# in OBS, no port to open and no password to keep.
#
# OBS_LOG_DIR moves the directory the logs are read from. Without it both the
# ordinary directory and the one a flatpak OBS keeps inside its own config are
# read, and the newest log of the two is the session that is running.
#
# A word in $XDG_RUNTIME_DIR/obs-tally-state is taken over anything OBS says,
# which is how obs-tally-simulate shows the light in all three states without
# opening OBS. The file lives on a tmpfs, so a reboot forgets it.

set -uo pipefail

SIMULATED="${XDG_RUNTIME_DIR:-/run/user/$UID}/obs-tally-state"

LOG_DIRS=("${OBS_LOG_DIR:-$HOME/.config/obs-studio/logs}")
[[ -n ${OBS_LOG_DIR:-} ]] ||
  LOG_DIRS+=("$HOME/.var/app/com.obsproject.Studio/config/obs-studio/logs")

if [[ -f $SIMULATED && ! -L $SIMULATED ]]; then
  read -r word <"$SIMULATED"
  case "$word" in
  live | idle | closed)
    echo "$word"
    exit 0
    ;;
  esac
fi

if ! pgrep -x obs >/dev/null; then
  echo closed
  exit 0
fi

log=""
for dir in "${LOG_DIRS[@]}"; do
  for file in "$dir"/*.txt; do
    [[ -f $file ]] || continue
    [[ -z $log || $file -nt $log ]] && log="$file"
  done
done

last=""
[[ -n $log ]] && last=$(grep -h '==== Streaming \(Start\|Stop\)' "$log" | tail -1)

if [[ $last == *"Streaming Start"* ]]; then
  echo live
else
  echo idle
fi
