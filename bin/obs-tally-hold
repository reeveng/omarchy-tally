#!/bin/bash

# Hold the desk still for the length of a stream, and put it back afterwards.
#
# While a stream is live, notifications stay off the screen, the idle lock
# leaves it alone, links open in a browser that knows nothing about you, and
# the drawers a keystroke opens are empty: the clipboard history, the recent
# files every file dialog offers, the notifications waiting to be read, the
# shell history behind a Ctrl-R. Bar widgets that name their machines out loud
# come off the bar.
#
# Only what this turned on is turned off again, and only what this put away is
# fetched back. Somebody who had do not disturb on before the stream started
# still has it on after, which is the whole reason there is a file here rather
# than a pair of assumptions.
#
#   obs-tally-hold hold [--browser ID] [--hide-widget ID]... [--no-dnd]
#                       [--no-awake] [--no-clipboard] [--no-recents]
#                       [--no-notifications] [--no-history]
#   obs-tally-hold release
#   obs-tally-hold status
#
# A second hold while one is running does nothing, so a shell that restarts
# mid-stream does not lose what it is holding. A release is safe at any moment
# and gives back whatever is still standing, which is what the post-boot hook
# is for: a machine that lost power mid-stream comes back with its history.

set -uo pipefail

# The state and the history flag are predictable names, so they go somewhere
# only this user can open. There is no falling back to a shared directory: a
# desk with no runtime directory of its own is not a desk being streamed from,
# and /tmp is a place anybody with an account can leave a symlink lying.
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
[[ -d $RUN_DIR && ! -L $RUN_DIR && -O $RUN_DIR ]] || {
  echo "no runtime directory of your own at $RUN_DIR, so there is nowhere private to keep this" >&2
  exit 1
}

STATE="$RUN_DIR/obs-tally-hold"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"

CLIPBOARD="$STATE_DIR/omarchy/clipboard-history.json"
NOTIFICATIONS="$STATE_DIR/omarchy/notifications/history"
RECENTS="$DATA_DIR/recently-used.xbel"
SHELL_CONFIG="$CONFIG_DIR/omarchy/shell.json"

# A shell cannot be reached into from out here, so it is told instead. The file
# is the whole message, and shell/tally-history.sh is what reads it.
HISTORY_FLAG="$RUN_DIR/obs-tally-history"

# What is put away is moved to this name beside itself, so the moved copy is
# its own record and a release finds it whether or not the state file lived.
ASIDE=".stream-held"

MARKER="# written by obs-tally-hold, deleted when the stream ends"

# An ordinary redirection follows a symlink and writes to whatever is on the far
# end of it, and a test beforehand only narrows the moment somebody has to swap
# the name in. noclobber makes the redirection an O_CREAT|O_EXCL open instead,
# which fails on anything already at the name, a symlink included and a dangling
# one too, so the rule is kept by the open itself.
#
# This one is for a name somebody else may own: an existing file, of any kind,
# means leave it alone.
write_fresh() {
  local path="$1"

  (
    set -C
    cat >"$path"
  ) 2>/dev/null
}

# This one is for the names this script owns, where anything sitting at the name
# is stale or planted. It is unlinked first, which takes away a symlink rather
# than following it, and the open still refuses whatever appeared in between.
write_ours() {
  local path="$1"

  rm -f -- "$path" 2>/dev/null
  write_fresh "$path" || {
    echo "could not write $path without following what is at it" >&2
    return 1
  }
}

# The read is not quiet: -q suppresses the answer as well as the error, which
# is a reading of "off" for a desk that is already silent.
dnd_is_on() {
  [[ $(omarchy-shell notifications isDnd 2>/dev/null) == "on" ]]
}

stay_awake_is_on() {
  omarchy-toggle-idle status 2>/dev/null | grep -q '"enabled":true'
}

# Where a desktop entry could be. A stream browser named in shell.json and
# missing from disk would route every link on stream into nothing, so the id is
# looked up before it is trusted.
desktop_entry_exists() {
  local id="$1" dir
  local IFS=:
  for dir in "$DATA_DIR" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
    [[ -f $dir/applications/$id ]] && return 0
  done
  return 1
}

# The desktop's own list sits above the one a person edits, so sending links
# elsewhere never touches mimeapps.list. Holding it is writing a file and
# releasing it is deleting the same file. The name is the desktop lowercased,
# which is where glib looks.
browser_lists() {
  local name
  local IFS=:
  for name in ${XDG_CURRENT_DESKTOP:-}; do
    [[ -n $name ]] && printf '%s/%s-mimeapps.list\n' "$CONFIG_DIR" "${name,,}"
  done
}

route_links() {
  local id="$1" list wrote=0

  desktop_entry_exists "$id" || {
    echo "no desktop entry named $id, leaving links where they are" >&2
    return 1
  }

  while read -r list; do
    # Somebody's own file, which this has no business rewriting. The open
    # settles it either way; this is only how the ordinary case stays quiet.
    [[ -e $list || -L $list ]] && continue

    if write_fresh "$list" <<EOF
$MARKER
[Default Applications]
text/html=$id
x-scheme-handler/http=$id
x-scheme-handler/https=$id
EOF
    then
      wrote=1
    fi
  done < <(browser_lists)

  ((wrote))
}

unroute_links() {
  local list
  while read -r list; do
    [[ -f $list ]] && head -1 "$list" | grep -qxF "$MARKER" && rm -f "$list"
  done < <(browser_lists)
}

# shell.json is somebody's own file and is often a link into a dotfiles
# checkout, so the rename lands on what the link points at rather than replacing
# the link with a file. A link pointing at nothing is not written at all.
config_file() {
  local target="$SHELL_CONFIG"

  if [[ -L $SHELL_CONFIG ]]; then
    target=$(readlink -f -- "$SHELL_CONFIG") || return 1
    [[ -f $target ]] || return 1
  fi

  printf '%s' "$target"
}

# A bar widget that names your machines out loud is a leak with a mouse on it.
# The entry is lifted out of the layout and kept beside shell.json with the
# section and the place in it, so the bar comes back in the order it was in
# rather than wherever the widget's manifest would have put it.
hide_widgets() {
  local ids=("$@") list held tmp

  ((${#ids[@]})) || return 1
  command -v jq >/dev/null || return 1
  [[ -f $SHELL_CONFIG && ! -e $SHELL_CONFIG$ASIDE && ! -L $SHELL_CONFIG$ASIDE ]] || return 1

  list=$(printf '%s\n' "${ids[@]}" | jq -R . | jq -sc .) || return 1

  held=$(jq -c --argjson ids "$list" '
    [ ["left","center","right"][] as $section
      | (.bar.layout[$section] // []) | to_entries[] as $at
      | select($ids | index(($at.value.id // "") | split("#")[0]))
      | {section: $section, index: $at.key, entry: $at.value} ]
  ' "$SHELL_CONFIG") || return 1

  [[ $held == "[]" ]] && return 1

  tmp=$(mktemp) || return 1
  jq --argjson ids "$list" '
    .bar.layout |= with_entries(
      if (.key | IN("left","center","right"))
      then .value |= map(. as $e | select(($ids | index(($e.id // "") | split("#")[0])) | not))
      else . end)
  ' "$SHELL_CONFIG" >"$tmp" || {
    rm -f -- "$tmp"
    return 1
  }

  local config
  config=$(config_file) || {
    rm -f -- "$tmp"
    return 1
  }

  printf '%s\n' "$held" | write_fresh "$SHELL_CONFIG$ASIDE" || {
    rm -f -- "$tmp"
    return 1
  }

  mv -- "$tmp" "$config"
}

show_widgets() {
  local tmp

  [[ -f $SHELL_CONFIG$ASIDE && ! -L $SHELL_CONFIG$ASIDE ]] || return 1
  command -v jq >/dev/null || return 1

  tmp=$(mktemp) || return 1

  # Put back in the order they were taken, so each one lands at the place it
  # left from and the ones after it shuffle along exactly once.
  jq --slurpfile held "$SHELL_CONFIG$ASIDE" '
    reduce (($held[0] // []) | sort_by(.index))[] as $it (.;
      .bar.layout[$it.section] = (
        (.bar.layout[$it.section] // [])[0:$it.index]
        + [$it.entry]
        + (.bar.layout[$it.section] // [])[$it.index:]))
  ' "$SHELL_CONFIG" >"$tmp" || {
    rm -f -- "$tmp"
    return 1
  }

  local config
  if ! config=$(config_file) || ! mv -- "$tmp" "$config"; then
    rm -f -- "$tmp"
    return 1
  fi

  rm -f -- "$SHELL_CONFIG$ASIDE"
}

put_away() {
  local path="$1" placeholder="${2-}"

  [[ -n $path && -e $path ]] || return 1
  [[ -e $path$ASIDE || -L $path$ASIDE ]] && return 1

  mv -- "$path" "$path$ASIDE" || return 1

  if [[ -d $path$ASIDE ]]; then
    mkdir -p -- "$path"
  elif [[ -n $placeholder ]]; then
    printf '%s\n' "$placeholder" | write_fresh "$path"
  fi
}

# What the stream wrote is dropped with it. Anything else would carry the
# stream's own copies into the history they were hidden from.
fetch_back() {
  local path="$1"

  [[ -n $path && -e $path$ASIDE ]] || return 1

  rm -rf -- "$path"
  mv -- "$path$ASIDE" "$path"
}

# A drawer asked for and not found is the failure worth hearing about: the
# setting is on, the stream is live, and the drawer is open after all. Either
# there is nothing in it yet, or it is somebody else's and this does not know
# where they keep it. Both are worth a sentence before the camera does.
hold_away() {
  local what="$1" path="$2" placeholder="${3-}"

  if put_away "$path" "$placeholder"; then
    return 0
  fi

  missing+=("$what ($path)")
  return 1
}

# Above do not disturb on purpose. This one is about the switch that was just
# thrown, so it is the one notification a silenced desk still has to show.
say_missing() {
  ((${#missing[@]})) || return 0

  local body
  body=$(printf '%s\n' "${missing[@]}")
  echo "not put away: $body" >&2
  command -v notify-send >/dev/null \
    && notify-send -u critical "󰝥  Still open on camera" \
      "Nothing was found to put away here, so it was left as it is:
$body"
}

hold() {
  local want_dnd=1 want_awake=1 want_clipboard=1 want_recents=1 want_notifications=1
  local want_history=1 browser="" changed="" widgets=() missing=()

  while (($#)); do
    case "$1" in
    --browser)
      [[ -n ${2-} && ${2-} != --* ]] || {
        echo "--browser wants a desktop entry, such as chromium.desktop" >&2
        exit 1
      }
      browser="$2"
      shift
      ;;
    --hide-widget)
      [[ -n ${2-} && ${2-} != --* ]] || {
        echo "--hide-widget wants a widget id, such as omarchy.tailscale" >&2
        exit 1
      }
      widgets+=("$2")
      shift
      ;;
    --no-dnd) want_dnd=0 ;;
    --no-awake) want_awake=0 ;;
    --no-clipboard) want_clipboard=0 ;;
    --no-recents) want_recents=0 ;;
    --no-notifications) want_notifications=0 ;;
    --no-history) want_history=0 ;;
    *)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    esac
    shift
  done

  [[ -f $STATE && ! -L $STATE ]] && exit 0

  if ((want_dnd)) && ! dnd_is_on; then
    omarchy-shell -q notifications setDnd true >/dev/null 2>&1 && changed+="dnd "
  fi

  if ((want_awake)) && ! stay_awake_is_on; then
    omarchy-toggle-idle stay-awake >/dev/null 2>&1 && changed+="awake "
  fi

  [[ -n $browser ]] && route_links "$browser" && changed+="browser "
  ((want_clipboard)) && hold_away "the clipboard history" "$CLIPBOARD" "[]" && changed+="clipboard "
  ((want_recents)) && hold_away "the recent files" "$RECENTS" && changed+="recents "
  ((want_notifications)) && hold_away "the notification backlog" "$NOTIFICATIONS" && changed+="notifications "
  ((want_history)) && write_ours "$HISTORY_FLAG" </dev/null && changed+="history "
  ((${#widgets[@]})) && hide_widgets "${widgets[@]}" && changed+="widgets "

  printf '%s\n' "$changed" | write_ours "$STATE"
  say_missing
  echo "holding: ${changed:-nothing}"
}

release() {
  local changed=""

  if [[ -f $STATE && ! -L $STATE ]]; then
    read -r changed <"$STATE"
    rm -f "$STATE"
  fi

  # The switches are only thrown back if this was the one that threw them.
  [[ $changed == *dnd* ]] && omarchy-shell -q notifications setDnd false >/dev/null 2>&1
  [[ $changed == *awake* ]] && omarchy-toggle-idle allow-idle >/dev/null 2>&1

  # What was put away is asked for by name, so a lost state file costs nobody
  # their clipboard.
  unroute_links
  fetch_back "$CLIPBOARD"
  fetch_back "$RECENTS"
  fetch_back "$NOTIFICATIONS"
  show_widgets
  rm -f -- "$HISTORY_FLAG"

  echo "released: ${changed:-nothing}"
}

status() {
  local changed

  if [[ -f $STATE && ! -L $STATE ]]; then
    read -r changed <"$STATE"
    echo "holding: ${changed:-nothing}"
  else
    echo "holding: nothing"
  fi
}

case "${1:-status}" in
hold)
  shift
  hold "$@"
  ;;
release)
  release
  ;;
status)
  status
  ;;
*)
  echo "usage: ${0##*/} [hold [--browser ID] [--hide-widget ID] [--no-dnd] [--no-awake] [--no-clipboard] [--no-recents] [--no-notifications] [--no-history]|release|status]" >&2
  exit 1
  ;;
esac
